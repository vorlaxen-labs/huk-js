{
  "name": "@vorlaxen-labs/huk-js",
  "version": "2.0.0",
  "description": "Zero-dependency, tree-shakable TypeScript utility kit — string, crypto, storage (SSR-safe), dates, and more for production apps.",
  "author": "Vorlaxen Labs",
  "license": "MIT",
  "keywords": [
    "typescript",
    "utilities",
    "utility-library",
    "helper",
    "tree-shaking",
    "zero-dependencies",
    "string-utils",
    "slugify",
    "turkish-locale",
    "validation",
    "crypto-utils",
    "localstorage",
    "ssr",
    "vorlaxen-labs",
    "huk",
    "huk-js",
    "bar-js"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorlaxen-labs/huk-js.git"
  },
  "bugs": {
    "url": "https://github.com/vorlaxen-labs/huk-js/issues"
  },
  "homepage": "https://github.com/vorlaxen-labs/huk-js#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./string": {
      "types": "./dist/modules/string/index.d.ts",
      "import": "./dist/modules/string/index.js",
      "require": "./dist/modules/string/index.cjs"
    },
    "./number": {
      "types": "./dist/modules/number/index.d.ts",
      "import": "./dist/modules/number/index.js",
      "require": "./dist/modules/number/index.cjs"
    },
    "./array": {
      "types": "./dist/modules/array/index.d.ts",
      "import": "./dist/modules/array/index.js",
      "require": "./dist/modules/array/index.cjs"
    },
    "./object": {
      "types": "./dist/modules/object/index.d.ts",
      "import": "./dist/modules/object/index.js",
      "require": "./dist/modules/object/index.cjs"
    },
    "./storage": {
      "types": "./dist/modules/storage/index.d.ts",
      "import": "./dist/modules/storage/index.js",
      "require": "./dist/modules/storage/index.cjs"
    },
    "./crypto": {
      "types": "./dist/modules/crypto/index.d.ts",
      "import": "./dist/modules/crypto/index.js",
      "require": "./dist/modules/crypto/index.cjs"
    },
    "./date": {
      "types": "./dist/modules/date/index.d.ts",
      "import": "./dist/modules/date/index.js",
      "require": "./dist/modules/date/index.cjs"
    },
    "./fn": {
      "types": "./dist/modules/function/index.d.ts",
      "import": "./dist/modules/function/index.js",
      "require": "./dist/modules/function/index.cjs"
    },
    "./is": {
      "types": "./dist/modules/is/index.d.ts",
      "import": "./dist/modules/is/index.js",
      "require": "./dist/modules/is/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "string": ["./dist/modules/string/index.d.ts"],
      "number": ["./dist/modules/number/index.d.ts"],
      "array": ["./dist/modules/array/index.d.ts"],
      "object": ["./dist/modules/object/index.d.ts"],
      "storage": ["./dist/modules/storage/index.d.ts"],
      "crypto": ["./dist/modules/crypto/index.d.ts"],
      "date": ["./dist/modules/date/index.d.ts"],
      "fn": ["./dist/modules/function/index.d.ts"],
      "is": ["./dist/modules/is/index.d.ts"],
      "*": ["./dist/index.d.ts"]
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "local-build": "npm run build && yalc push --force",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && npm run test",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "semantic-release": "^25.0.3",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "tinyglobby": "^0.2.16",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
